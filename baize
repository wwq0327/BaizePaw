#!/bin/zsh
# BaizePaw 启动脚本

# 获取脚本所在目录
SCRIPT_DIR="${0:a:h}"
PROJECT_DIR="$SCRIPT_DIR"

# 检查 API Key
if [ -z "$LLM_API_KEY" ] && [ -z "$DEEPSEEK_API_KEY" ]; then
    echo "错误：请先设置 LLM_API_KEY 环境变量"
    echo "方式一：export LLM_API_KEY='your-api-key'"
    echo "方式二：在 .env 文件中配置 LLM_API_KEY"
    exit 1
fi

# 激活虚拟环境并运行
cd "$PROJECT_DIR"
source ../.venv/bin/activate
PYTHONPATH=. python main.py
